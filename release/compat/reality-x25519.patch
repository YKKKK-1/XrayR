--- /dev/null
+++ b/legacy_x25519_test.go
@@ -0,0 +1,29 @@
+package reality
+
+import "testing"
+
+func TestLegacyX25519Hello(t *testing.T) {
+	classic := keyShare{group: X25519, data: make([]byte, 32)}
+	hybrid := keyShare{group: X25519MLKEM768}
+	other := keyShare{group: CurveP256, data: make([]byte, 65)}
+	cases := []struct {
+		name   string
+		shares []keyShare
+		allow  bool
+	}{
+		{"one classical share", []keyShare{classic}, true},
+		{"other offered groups", []keyShare{other, classic}, true},
+		{"no classical share", []keyShare{other}, false},
+		{"invalid classical length", []keyShare{{group: X25519, data: make([]byte, 31)}}, false},
+		{"duplicate classical", []keyShare{classic, classic}, false},
+		{"hybrid after classical", []keyShare{classic, hybrid}, false},
+		{"hybrid before classical", []keyShare{hybrid, classic}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := isLegacyX25519Hello(tc.shares); got != tc.allow {
+				t.Errorf("isLegacyX25519Hello() = %v, want %v", got, tc.allow)
+			}
+		})
+	}
+}
