diff --git a/legacy_x25519.go b/legacy_x25519.go
new file mode 100644
--- /dev/null
+++ b/legacy_x25519.go
@@ -0,0 +1,19 @@
+package reality
+
+// isLegacyX25519Hello admits a single classical share only if the client
+// omitted the hybrid group entirely. A rejected hybrid offer stays rejected.
+func isLegacyX25519Hello(shares []keyShare) bool {
+	found := false
+	for _, share := range shares {
+		switch share.group {
+		case X25519MLKEM768:
+			return false
+		case X25519:
+			if found || len(share.data) != 32 {
+				return false
+			}
+			found = true
+		}
+	}
+	return found
+}
